{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:miniapp",
  "outputDirectory": "src/mini-app/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/tools-suite/(.*)",
      "destination": "/tools-suite/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
