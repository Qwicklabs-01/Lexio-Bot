
# ==========================================
# Telegram Bot Configuration
# ==========================================
# Get from @BotFather on Telegram (e.g. 123456789:ABCdefGHIjklMNOpqrSTUvwxYZ)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Secret string used to verify incoming webhook requests (header X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=your-random-secret-token-32-characters-min

# Comma-separated Telegram User IDs with Administrator privileges
ADMIN_IDS=123456789,987654321

# ==========================================
# Server & Deployment Configuration
# ==========================================
PORT=3000
NODE_ENV=development

# Public HTTPS URL of this deployment (Leave empty for local development with long-polling)
# Example: https://omni-bot.up.railway.app
WEBHOOK_DOMAIN=

# URL where the Telegram Mini App is hosted
# In development: http://localhost:5173
# In production: https://omni-bot.up.railway.app/app
MINI_APP_URL=http://localhost:5173

# ==========================================
# Security & Auth
# ==========================================
JWT_SECRET=super-secret-jwt-signing-key-minimum-32-chars-long-change-in-prod

# ==========================================
# Database Configuration
# ==========================================
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omni_telegram_platform?schema=public

# ==========================================
# Optional Integrations
# ==========================================
# Telegram Payments provider token from @BotFather (e.g. Stripe, Razorpay)
PAYMENT_PROVIDER_TOKEN=
